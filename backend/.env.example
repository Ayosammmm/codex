# Modèle de configuration : copier en `.env` et remplir les valeurs
DB_HOST=localhost
DB_PORT=3306
DB_NAME=almanach
DB_USER=almanach
DB_PASSWORD=
# (laisser vide si MySQL local sans mot de passe)

PORT=5000

# Secret des jetons de connexion : une longue chaîne aléatoire (ex. `openssl rand -hex 48`)
JWT_SECRET=
# Premier super admin : créé automatiquement au démarrage si la base ne contient AUCUN compte.
# Ignoré ensuite (ne modifie jamais un compte existant). Mot de passe : 8 caractères minimum.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrateur
